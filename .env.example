# Local development only. Recommended setup: node scripts/setup-local.mjs
# The setup helper generates the three blank values below using secure randomness.
# Never commit your real .env file or reuse demo accounts in production.

# Used by compose.yaml to start a local PostgreSQL database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Used by Next.js, Drizzle Kit, and the seed script.
# Format: postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
# If using native/hosted PostgreSQL, supply that database's connection URL instead.
DATABASE_URL=

# Server-only JWT signing secret. Use at least 32 random bytes.
# Do not add a NEXT_PUBLIC_ prefix to either secret or to DATABASE_URL.
JWT_SECRET=
